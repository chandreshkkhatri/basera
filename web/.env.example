# Postgres connection used by both `drizzle-kit` and the Next.js app.
# Local dev uses the docker-compose Postgres, published on host port 5433.
DATABASE_URL=postgres://basera:basera@localhost:5433/basera

# Shared secret gating the /admin panel (enable/disable cities, manage groups).
# Leave unset to disable admin access entirely.
ADMIN_TOKEN=change-me

# --- Firebase (Google sign-in + Firestore-backed saved listings) ---------
# Public client config from the Firebase console (Project settings → your web
# app). NOT secrets — access is enforced by Firestore rules + OAuth authorized
# domains. Leave unset to disable auth entirely (browsing stays public; saves
# fall back to this device only).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
