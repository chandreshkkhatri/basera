# Ingestion engine configuration (Python). Copy to .env and fill in.
# The web app uses its own web/.env.local for DATABASE_URL.

# Shared database (host port 5433 -> docker-compose Postgres).
# For hosted Postgres (Neon/Supabase), append ?sslmode=require.
DATABASE_URL=postgresql+psycopg://basera:basera@localhost:5433/basera

# --- LLM provider ---
MODEL_PROVIDER=openai            # openai | gemini
# MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
# GEMINI_API_KEY=

# Retry AI-processing failures later instead of dropping them immediately.
# Each failure keeps the raw post pending until the retry budget is exhausted.
# PROCESSING_MAX_ATTEMPTS=3
# PROCESSING_RETRY_BACKOFF_S=300

# --- Geocoding ---
GOOGLE_MAPS_API_KEY=

# --- Facebook ---
# Groups are registered in the DB (via `ingestion groups add` or the web /admin
# panel), not here. These are only needed for Graph API mode (`run --api`).
# FB_ACCESS_TOKEN=
# FB_GROUP_ID=

# --- Optional: browser settings for Facebook scraping ---
# CHROME_USER_DATA_DIR=            # reuse an existing Chrome profile
# BROWSER_CHANNEL=chrome           # set empty in Docker to use bundled Chromium
# HEADLESS=false                   # true for unattended/server runs

# --- Alerting (Telegram) ---
# Alerts are always recorded in the `alerts` DB table; these enable delivery.
# 1. Create a bot: message @BotFather on Telegram -> /newbot -> copy the token.
# 2. Send any message to your new bot, then find your chat id with:
#    curl -s https://api.telegram.org/bot<TOKEN>/getUpdates | grep -o '"chat":{"id":[0-9-]*'
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Toggle delivery per category: "all", "none", or a comma-separated subset of
# run_failure,login_expiry,quota_exceeded,stale_data,processing_failed,db_unavailable
# ALERT_CATEGORIES=all
# Minutes between deliveries of the same category (suppressed ones are still recorded).
# ALERT_COOLDOWN_MINUTES=30
# ALERT_COOLDOWN_OVERRIDES=stale_data=240,db_unavailable=60
# Stale-data watchdog (`ingestion watchdog`): alert if no successful run /
# no new posts within these windows.
# ALERT_STALE_RUN_HOURS=2
# ALERT_STALE_POSTS_HOURS=12
