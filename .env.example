# Ingestion engine configuration (Python). Copy to .env and fill in.
# The web app uses its own web/.env.local for DATABASE_URL.

# Shared database (host port 5433 -> docker-compose Postgres)
DATABASE_URL=postgresql+psycopg://basera:basera@localhost:5433/basera

# --- LLM provider ---
MODEL_PROVIDER=openai            # openai | gemini
# MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Geocoding ---
GOOGLE_MAPS_API_KEY=

# --- Telegram ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TARGET_CHAT=@some_group
# TARGET_PEER_ID=-100xxxxxxxxxx

# --- WhatsApp ---
WHATSAPP_TARGET_CHAT=

# --- Facebook ---
FACEBOOK_TARGET_GROUP=
# FB_ACCESS_TOKEN=
# FB_GROUP_ID=

# --- Optional: reuse an existing Chrome profile for WhatsApp/Facebook ---
# CHROME_USER_DATA_DIR=
